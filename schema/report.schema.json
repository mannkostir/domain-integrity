{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domain-integrity:report:v2",
  "title": "domain-integrity check report",
  "description": "Output of `domain-integrity check --format json`, format version 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tool", "summary", "findings", "known", "problems"],
  "properties": {
    "version": { "const": 2 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "domain-integrity" }, "version": { "type": "string" } }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "known", "problems"],
      "properties": {
        "errors": { "$ref": "#/$defs/count" },
        "warnings": { "$ref": "#/$defs/count" },
        "known": { "$ref": "#/$defs/count" },
        "problems": { "$ref": "#/$defs/count" }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "known": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "problems": { "type": "array", "items": { "$ref": "#/$defs/problem" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "minLength": 1 },
    "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "values": { "type": "array", "items": { "type": "string" } },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "analyzer", "identity", "location", "message", "fix", "details"],
      "properties": {
        "ruleId": {
          "enum": [
            "terminal-state-leak",
            "unreachable-state",
            "outside-mutation",
            "transition-drift",
            "transition-missing",
            "dead-handler",
            "handler-payload-mismatch",
            "unhandled-event",
            "saga-missing-failure-path",
            "undispatched-events"
          ]
        },
        "severity": { "enum": ["error", "warning"] },
        "analyzer": { "enum": ["lifecycle", "event-flow"] },
        "identity": { "type": "object" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line"],
          "properties": { "file": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 } }
        },
        "message": { "type": "string" },
        "fix": { "type": "string" },
        "details": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "ruleId": { "const": "terminal-state-leak" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "identity": { "$ref": "#/$defs/terminalStateLeakIdentity" }, "details": { "$ref": "#/$defs/terminalStateLeakDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "unreachable-state" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "identity": { "$ref": "#/$defs/unreachableStateIdentity" }, "details": { "$ref": "#/$defs/unreachableStateDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "outside-mutation" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "identity": { "$ref": "#/$defs/outsideMutationIdentity" }, "details": { "$ref": "#/$defs/outsideMutationDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "transition-drift" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "identity": { "$ref": "#/$defs/transitionDriftIdentity" }, "details": { "$ref": "#/$defs/transitionDriftDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "transition-missing" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "identity": { "$ref": "#/$defs/transitionMissingIdentity" }, "details": { "$ref": "#/$defs/transitionMissingDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "dead-handler" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "identity": { "$ref": "#/$defs/deadHandlerIdentity" }, "details": { "$ref": "#/$defs/deadHandlerDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "handler-payload-mismatch" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "identity": { "$ref": "#/$defs/handlerPayloadMismatchIdentity" }, "details": { "$ref": "#/$defs/handlerPayloadMismatchDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "unhandled-event" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "identity": { "$ref": "#/$defs/unhandledEventIdentity" }, "details": { "$ref": "#/$defs/unhandledEventDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "saga-missing-failure-path" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "identity": { "$ref": "#/$defs/sagaMissingFailurePathIdentity" }, "details": { "$ref": "#/$defs/sagaMissingFailurePathDetails" } } } },
        { "if": { "properties": { "ruleId": { "const": "undispatched-events" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "identity": { "$ref": "#/$defs/undispatchedEventsIdentity" }, "details": { "$ref": "#/$defs/undispatchedEventsDetails" } } } }
      ]
    },
    "terminalStateLeakIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "aggregate", "method", "field", "values"],
      "properties": {
        "rule": { "const": "terminal-state-leak" },
        "aggregate": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/name" } }
      }
    },
    "unreachableStateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "aggregate", "field", "value"],
      "properties": {
        "rule": { "const": "unreachable-state" },
        "aggregate": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "value": { "$ref": "#/$defs/name" }
      }
    },
    "outsideMutationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "aggregate", "field", "file", "scope"],
      "properties": {
        "rule": { "const": "outside-mutation" },
        "aggregate": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "file": { "$ref": "#/$defs/name" },
        "scope": { "$ref": "#/$defs/name" }
      }
    },
    "transitionDriftIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "aggregate", "method", "field", "kind"],
      "properties": {
        "rule": { "const": "transition-drift" },
        "aggregate": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "kind": { "$ref": "#/$defs/name" }
      }
    },
    "transitionMissingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "aggregate", "method", "field"],
      "properties": {
        "rule": { "const": "transition-missing" },
        "aggregate": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" }
      }
    },
    "deadHandlerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "event", "handlerClass", "handlerMethod"],
      "properties": {
        "rule": { "const": "dead-handler" },
        "event": { "$ref": "#/$defs/name" },
        "handlerClass": { "type": ["string", "null"] },
        "handlerMethod": { "type": ["string", "null"] }
      }
    },
    "handlerPayloadMismatchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "event", "handlerClass", "handlerMethod", "declared"],
      "properties": {
        "rule": { "const": "handler-payload-mismatch" },
        "event": { "$ref": "#/$defs/name" },
        "handlerClass": { "type": ["string", "null"] },
        "handlerMethod": { "type": ["string", "null"] },
        "declared": { "type": "array", "items": { "$ref": "#/$defs/name" } }
      }
    },
    "unhandledEventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "event"],
      "properties": {
        "rule": { "const": "unhandled-event" },
        "event": { "$ref": "#/$defs/name" }
      }
    },
    "sagaMissingFailurePathIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "saga", "success", "failure"],
      "properties": {
        "rule": { "const": "saga-missing-failure-path" },
        "saga": { "$ref": "#/$defs/name" },
        "success": { "$ref": "#/$defs/name" },
        "failure": { "$ref": "#/$defs/name" }
      }
    },
    "undispatchedEventsIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "owner", "buffer"],
      "properties": {
        "rule": { "const": "undispatched-events" },
        "owner": { "$ref": "#/$defs/name" },
        "buffer": { "$ref": "#/$defs/name" }
      }
    },
    "terminalStateLeakDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "method", "field", "values"],
      "properties": {
        "aggregate": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "values": { "type": "array", "minItems": 1, "allOf": [{ "$ref": "#/$defs/values" }] }
      }
    },
    "unreachableStateDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "field", "value"],
      "properties": {
        "aggregate": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "value": { "type": "string" }
      }
    },
    "outsideMutationDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "field", "scope"],
      "properties": {
        "aggregate": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "scope": { "$ref": "#/$defs/name" }
      }
    },
    "transitionDriftDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "method", "field", "kind", "values"],
      "properties": {
        "aggregate": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["extra", "undeclared"] },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "transitionMissingDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "method", "field", "values"],
      "properties": {
        "aggregate": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "values": { "type": "array", "minItems": 1, "allOf": [{ "$ref": "#/$defs/values" }] }
      }
    },
    "deadHandlerDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "handler"],
      "properties": {
        "event": { "$ref": "#/$defs/name" },
        "handler": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
      }
    },
    "handlerPayloadMismatchDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "handler", "declared"],
      "properties": {
        "event": { "$ref": "#/$defs/name" },
        "handler": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "declared": { "type": "array", "minItems": 1, "allOf": [{ "$ref": "#/$defs/names" }] }
      }
    },
    "unhandledEventDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": { "event": { "$ref": "#/$defs/name" } }
    },
    "sagaMissingFailurePathDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["saga", "success", "failure"],
      "properties": {
        "saga": { "$ref": "#/$defs/name" },
        "success": { "$ref": "#/$defs/name" },
        "failure": { "$ref": "#/$defs/name" }
      }
    },
    "undispatchedEventsDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "buffer", "method", "raisers"],
      "properties": {
        "owner": { "$ref": "#/$defs/name" },
        "buffer": { "$ref": "#/$defs/name" },
        "method": { "$ref": "#/$defs/name" },
        "raisers": { "type": "array", "minItems": 1, "allOf": [{ "$ref": "#/$defs/names" }] }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "analyzer", "message", "details"],
      "properties": {
        "code": {
          "enum": [
            "state-field-accessor",
            "state-field-missing",
            "state-field-unsupported-type",
            "unknown-state-value",
            "transition-method-missing",
            "event-not-analysed",
            "saga-outcome-unhandled"
          ]
        },
        "analyzer": { "enum": ["lifecycle", "event-flow"] },
        "message": { "type": "string" },
        "details": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "code": { "const": "state-field-accessor" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "details": { "$ref": "#/$defs/aggregateFieldProblemDetails" } } } },
        { "if": { "properties": { "code": { "const": "state-field-missing" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "details": { "$ref": "#/$defs/aggregateFieldProblemDetails" } } } },
        { "if": { "properties": { "code": { "const": "state-field-unsupported-type" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "details": { "$ref": "#/$defs/unsupportedTypeProblemDetails" } } } },
        { "if": { "properties": { "code": { "const": "unknown-state-value" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "details": { "$ref": "#/$defs/unknownStateValueProblemDetails" } } } },
        { "if": { "properties": { "code": { "const": "transition-method-missing" } } }, "then": { "properties": { "analyzer": { "const": "lifecycle" }, "details": { "$ref": "#/$defs/transitionMethodMissingProblemDetails" } } } },
        { "if": { "properties": { "code": { "const": "event-not-analysed" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "details": { "$ref": "#/$defs/eventNotAnalysedProblemDetails" } } } },
        { "if": { "properties": { "code": { "const": "saga-outcome-unhandled" } } }, "then": { "properties": { "analyzer": { "const": "event-flow" }, "details": { "$ref": "#/$defs/sagaOutcomeUnhandledProblemDetails" } } } }
      ]
    },
    "aggregateFieldProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "field"],
      "properties": { "aggregate": { "$ref": "#/$defs/name" }, "field": { "$ref": "#/$defs/name" } }
    },
    "unsupportedTypeProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "field", "type"],
      "properties": { "aggregate": { "$ref": "#/$defs/name" }, "field": { "$ref": "#/$defs/name" }, "type": { "type": "string" } }
    },
    "unknownStateValueProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "field", "value", "known"],
      "properties": {
        "aggregate": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "value": { "type": "string" },
        "known": { "$ref": "#/$defs/values" }
      }
    },
    "transitionMethodMissingProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "method"],
      "properties": { "aggregate": { "$ref": "#/$defs/name" }, "method": { "$ref": "#/$defs/name" } }
    },
    "eventNotAnalysedProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": { "event": { "$ref": "#/$defs/name" } }
    },
    "sagaOutcomeUnhandledProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["saga", "success", "failure"],
      "properties": { "saga": { "$ref": "#/$defs/name" }, "success": { "$ref": "#/$defs/name" }, "failure": { "$ref": "#/$defs/name" } }
    }
  }
}

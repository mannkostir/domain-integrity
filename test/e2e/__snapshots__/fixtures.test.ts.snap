              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "transition-missing",
              "shortDescription": {
                "text": "A method cannot run from a state its declared transition allows."
              },
              "fullDescription": {
                "text": "A method's guard keeps it from running in a state that its entry in transitions lists, so the declaration promises a transition the code no longer offers. It is a warning: the code is not breaking a rule, but the declaration has drifted from it."
              },

{
  "name": "domain-integrity",
  "version": "0.3.0",
  "description": "Checks that a TypeScript domain's aggregate lifecycles and in-process event flows match their declared intent.",
  "type": "module",
  "license": "MIT",
  "author": "mannkostir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannkostir/domain-integrity.git"
  },
  "homepage": "https://github.com/mannkostir/domain-integrity#readme",
  "bugs": {
    "url": "https://github.com/mannkostir/domain-integrity/issues"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "aggregate",
    "lifecycle",
    "state-machine",
    "domain-events",
    "event-handlers",
    "saga",
    "typescript",
    "static-analysis",
    "ts-morph",
    "cli",
    "ci"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "domain-integrity": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./schema/report.json": "./schema/report.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:pack": "npm run build && bash scripts/test-pack.sh"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}

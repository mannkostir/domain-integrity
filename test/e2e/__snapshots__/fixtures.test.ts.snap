exports[`fixture projects > enum-inline: agent context 1`] = `
"## Domain lifecycles

Rules for changing these aggregates:
- Never change an aggregate after it reaches a terminal state, except through the listed methods.
- Change state only through the aggregate's own methods.
- Run \`domain-integrity check\` after changing domain code.

### Order (src/order.ts)
- status: pending, confirmed, paid, placed, cancelled
  - terminal: cancelled
  - confirm: pending → confirmed
  - place: paid → placed
  - cancel: pending, confirmed → cancelled
"
`;

exports[`fixture projects > enum-inline: diagram 1`] = `
"## Order.status

\`\`\`mermaid
stateDiagram-v2
  state "pending" as status_0
  state "confirmed" as status_1
  state "paid" as status_2
  state "placed" as status_3
  state "cancelled" as status_4
  [*] --> status_0
  status_0 --> status_1 : confirm
  status_1 --> status_3 : place ⚠ undeclared
  status_0 --> status_4 : cancel
  status_1 --> status_4 : cancel
  status_2 --> status_4 : cancel ⚠ undeclared
  status_3 --> status_4 : cancel ⚠ undeclared
  status_4 --> status_4 : annotate ⚠ leak
  status_4 --> [*]
  classDef terminal font-weight:bold
  classDef leak fill:#fde2e2,stroke:#c0392b
  class status_4 leak
\`\`\`
"
`;

exports[`fixture projects > enum-inline: text report 1`] = `
"error unreachable-state  Order  src/order.ts:6
  status value 'paid' is never assigned.
  Fix: Add the method that moves Order into 'paid', or remove the value from the type.

error transition-drift  Order.place()  src/order.ts:26
  place() can run from 'confirmed', which the declaration does not allow.
  Fix: Add a guard that excludes 'confirmed', or add it to transitions.place.

warning transition-drift  Order.place()  src/order.ts:26
  place() cannot run from 'paid', although the declaration allows it.
  Fix: Remove 'paid' from transitions.place, or relax the guard.

error transition-drift  Order.cancel()  src/order.ts:31
  cancel() can run from 'paid', 'placed', which the declaration does not allow.
  Fix: Add a guard that excludes 'paid', 'placed', or add them to transitions.cancel.

error terminal-state-leak  Order.annotate()  src/order.ts:36
  annotate() can run after status is 'cancelled'.
  Fix: Guard annotate() so it cannot run when status is 'cancelled', or list it in allowAfterTerminal if that is intended.

4 errors, 1 warning
"
`;

